<div class="events-page">
  <div class="events-header">
    <h1 class="events-title">Saved Events</h1>
  </div>

  <% if @events.any? %>
    <div class="events-grid">
      <% @events.each do |event| %>
        <article class="event-card">

          <%= link_to event_path(event), class: "event-card-link" do %>

            <!-- Image Carousel -->
          <div class="relative h-48 overflow-hidden bg-gray-100">
            <% if event.media_files.attached? && event.media_files.any? %>
              <!-- Images Container -->
              <div class="flex overflow-x-auto snap-x snap-mandatory h-full [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
                <% event.media_files.each do |file| %>
                  <div class="flex-none w-full h-full snap-start">
                    <%= image_tag file, class: "w-full h-full object-cover", alt: event.title, loading: "lazy" %>
                  </div>
                <% end %>
              </div>

              <!-- Dots Indicator -->
              <% if event.media_files.count > 1 %>
                <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-1.5 pointer-events-none">
                  <% event.media_files.count.times do |i| %>
                    <% dot_class = i == 0 ? "bg-white" : "bg-white/60" %>
                    <div class="w-1.5 h-1.5 rounded-full <%= dot_class %>"></div>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <%= image_tag event_default_image(event), class: "w-full h-full object-cover", alt: event.title %>
            <% end %>

              <span class="event-badge">
                <%= event.price.present? ? "$#{event.price}" : "Free" %>
              </span>
            </div>

            <div class="event-content">
              <h2 class="event-name"><%= event.title %></h2>

              <div class="event-time">
                <%= event.starts_at.strftime("%a, %b %-d · %-I:%M %p") if event.starts_at %>
              </div>

              <div class="event-by">
                by
                <%= event.user.present? ?
                      [event.user.first_name, event.user.last_name].compact.join(" ").presence || event.user.email
                      : "Unknown" %>
              </div>
            </div>

          <% end %>

          <%= button_to "❤️",
                event_favorite_path(event),
                method: :delete,
                class: "favorite-btn",
                form: { class: "favorite-form" } %>

        </article>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 mt-4">You haven’t saved any events yet.</p>
  <% end %>
</div>
