<div class="saved-events-page">
  <h1>Saved Events</h1>

  <% if @events.any? %>
    <ul>
      <% @events.each do |event| %>
        <li>
          <%= link_to event.title, event_path(event) %>

          <%= button_to "Remove ❤️",
                event_favorite_path(event),
                method: :delete %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>You haven’t saved any events yet.</p>
  <% end %>
</div>
