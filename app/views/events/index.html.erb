<div class="events-page">
<script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>
  <!-- Header -->
  <div class="events-header">
  <% if user_signed_in? %>
      <% if current_user.location_type == 'online' %>
        <%= link_to "Search for Online Events", events_path(location: 'online') %>
      <% else %>
        <h1 class="events-title">
          Filter for events near
          <span class="events-location">
            <%= link_to "#{current_user.city}, #{current_user.state}", events_path(city: current_user.city, state: current_user.state) %>
          </span>
        </h1>
      <% end %>
    <% end %>
    <h1 class="events-title">
      Events near
      <span class="events-location">
        here City, state
      </span>
    </h1>

    <%= link_to "See all events", events_path, class: "events-see-all" %>
  </div>

  <!-- Grid -->
  <div class="events-grid">
    <% @events.each do |event| %>
      <article class="event-card">
        <%= link_to event_path(event), class: "event-card-link" do %>

            <div class="event-image-wrap">
              <%= image_tag event.default_image_path,
                    class: "event-image",
                    alt: event.title %>

              <span class="event-badge">
                <%= event.price.present? ? "$#{event.price}" : "Free" %>
              </span>
          </div>

          <div class="event-content">
            <h2 class="event-name"><%= event.title %></h2>

            <div class="event-time">
              <% if event.starts_at.present? %>
                <%= event.starts_at.strftime("%a, %b %-d · %-I:%M %p %Z") %>
              <% else %>
                Date & time TBD
              <% end %>
            </div>

            <div class="event-by">
              by
              <%= event.user.present? ?
                    [event.user.first_name, event.user.last_name].compact.join(" ").presence || event.user.email
                    : "Unknown" %>
            </div>
          </div>
        <% end %>
        <!-- Favorite button -->
        <% if user_signed_in? %>
          <% favorite = current_user.favorites.find_by(event_id: event.id) %>

          <% if favorite %>
            <%= button_to "❤️",
                  event_favorite_path(event),
                  method: :delete,
                  class: "favorite-btn",
                  form: { class: "favorite-form" } %>
          <% else %>
            <%= button_to "🤍",
                  event_favorite_path(event),
                  method: :post,
                  class: "favorite-btn",
                  form: { class: "favorite-form" } %>
          <% end %>
        <% end %> 

      </article>
    <% end %>
  </div>
</div>