<div class = "lex flex-col w-full gap-4">
    <h1 class="text-2xl font-bold mb-4"> Search Results </h1>
    <% if @results.present? %>
        <div>
            <% @results.each do |event| %>
                <%= render event %>
            <% end %>
        </div>
    <%  else %>
        <p> No results.</p>
    <% end %>
    <div>
        <%= link_to "Return to events page", events_path %>
    </div>
</div>