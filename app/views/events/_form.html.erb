<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="bg-white border border-[#E5E5E5] rounded-xl p-6 sm:p-8"><%= form_with(model: @event) do |form| %>

      <div class="space-y-10">

        <% if @event.errors.any? %>
          <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            <h2 class="font-semibold mb-2">
              <%= pluralize(@event.errors.count, "error") %> prevented this event from being saved:
            </h2>
            <ul class="list-disc list-inside space-y-1">
              <% @event.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
<div class="event-form-card">
  <%= form_with(model: @event) do |form|%>
    <%= hidden_field_tag :from, params[:from] if params[:from].present? %>
      <div class="space-y-12">
        <% if event.errors.any? %>
            <div style="color: red">
                <h2><%= pluralize(event.errors.count, "error") %> prevented this event from being saved:</h2>
                <ul>
                    <% event.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                    <% end %>
                </ul>
            </div>
        <% end %>

      <div class="border-b border-gray-900/10 pb-12">
        <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
          <div class="sm:col-span-4">
            <%= form.label :title, class:"block text-sm/6 font-medium text-gray-900" %>
            <div class="mt-2">
              <div class="flex items-center rounded-md bg-white pl-3 outline-1 -outline-offset-1 outline-gray-300 focus-within:outline-2 focus-within:-outline-offset-2 focus-within:outline-indigo-600">
                <%= form.text_field :title, placeholder:"Name of your event...", class:"block min-w-0 grow bg-white py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6" %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- BASIC INFO -->
        <div class="space-y-8">

          <div>
            <%= form.label :title, class: "block text-sm font-medium text-[#14213D]" %>
            <div class="mt-2">
              <%= form.text_field :title,
                    placeholder: "Name of your event...",
                    class: "block w-full rounded-md border border-[#E5E5E5] bg-white px-3 py-2 text-sm text-black placeholder:text-gray-400 focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
            </div>
          </div>

          <div>
            <%= form.label :description, class: "block text-sm font-medium text-[#14213D]" %>
            <div class="mt-2">
              <%= form.text_field :description,
                    placeholder: "Write a few sentences about the event!",
                    class: "block w-full rounded-md border border-[#E5E5E5] bg-white px-3 py-2 text-sm text-black placeholder:text-gray-400 focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
            </div>
          </div>

          <div class="col-span-full">
            <%= form.label :media_files, "Event Images (max 5)", class:"block text-sm/6 font-medium text-gray-900" %>
            <div class="mt-2">
              <%= form.file_field :media_files,
                    multiple: true,
                    accept: "image/*",
                    class:"block w-full text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" %>
              <p class="mt-1 text-xs text-gray-500">PNG, JPG, GIF, WEBP up to 10MB each</p>
            </div>

            <!-- Show existing images on edit -->
            <% if @event.persisted? && @event.media_files.attached? %>
              <div class="mt-3 flex gap-2 flex-wrap">
                <% @event.media_files.each do |file| %>
                  <div class="relative">
                    <%= image_tag file, class: "w-20 h-20 object-cover rounded border" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="sm:col-span-3">
            <%= form.label :location, class:"block text-sm/6 font-medium text-gray-900" %>
            <div class="mt-2 grid grid-cols-1">
              <%= form.select :location, options_for_select([['Online','online'],['In-person','in-person'],['Hybrid','hybrid']], form.object.location),{},class:"col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pr-8 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %> 
            </div>
          </div>

        </div>

        <!-- LOCATION & TIME -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

          <div>
            <%= form.label :city, class: "block text-sm font-medium text-[#14213D]" %>
            <div class="mt-2">
              <%= form.text_field :city,
                    placeholder: "City",
                    class: "block w-full rounded-md border border-[#E5E5E5] bg-white px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
            </div>
          </div>

          <div>
            <%= form.label :state, class: "block text-sm font-medium text-[#14213D]" %>
            <div class="mt-2">
              <%= form.text_field :state,
                    placeholder: "State",
                    class: "block w-full rounded-md border border-[#E5E5E5] bg-white px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
            </div>
          </div>

          <div>
            <%= form.label :location, class: "block text-sm font-medium text-[#14213D]" %>
            <div class="mt-2">
              <%= form.select :location,
                    options_for_select([["Online","online"],["In-person","in-person"],["Hybrid","hybrid"]]),
                    class: "block w-full rounded-md border border-[#E5E5E5] bg-white px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
            </div>
          </div>

          <div>
            <%= form.label :starts_at, class: "block text-sm font-medium text-[#14213D]" %>
            <div class="mt-2">
              <%= form.datetime_field :starts_at,
                    class: "block w-full rounded-md border border-[#E5E5E5] bg-white px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
            </div>
          </div>

          <div class="sm:col-span-2">
            <%= form.label :max_capacity, class:"block text-sm/6 font-medium text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :max_capacity, class:"block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
            </div>
          </div>

          <div class="mb-4">
            <%= form.label :registration_deadline, "Registration Deadline", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.datetime_local_field :registration_deadline,
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#FCA311] focus:border-transparent" %>
            <p class="mt-1 text-sm text-gray-500">Optional: Set when registration closes (must be before event start)</p>
          </div>

        </div>

        <!-- RULES -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

          <div>
            <%= form.label :min_age, class: "block text-sm font-medium text-[#14213D]" %>
            <%= form.number_field :min_age,
                  class: "mt-2 block w-full rounded-md border border-[#E5E5E5] px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
          </div>

          <div>
            <%= form.label :max_age, class: "block text-sm font-medium text-[#14213D]" %>
            <%= form.number_field :max_age,
                  class: "mt-2 block w-full rounded-md border border-[#E5E5E5] px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
          </div>

          <div>
            <%= form.label :max_participants, class: "block text-sm font-medium text-[#14213D]" %>
            <%= form.number_field :max_participants,
                  class: "mt-2 block w-full rounded-md border border-[#E5E5E5] px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
          </div>

        </div>

        <!-- SELECTS -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

          <div>
            <%= form.label :allowed_gender, class: "block text-sm font-medium text-[#14213D]" %>
            <%= form.select :allowed_gender,
                  Event.allowed_genders.keys.map { |k| [k.humanize.titleize, k] },
                  class: "mt-2 block w-full rounded-md border border-[#E5E5E5] px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
          </div>

          <div>
            <%= form.label :rsvp, class: "block text-sm font-medium text-[#14213D]" %>
            <%= form.select :rsvp,
                  Event.rsvps.keys.map { |k| [k.humanize.titleize, k] },
                  class: "mt-2 block w-full rounded-md border border-[#E5E5E5] px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
          </div>

          <div>
            <%= form.label :category, class: "block text-sm font-medium text-[#14213D]" %>
            <%= form.select :category,
                  Event.categories.keys.map { |k| [k.humanize.titleize, k] },
                  class: "mt-2 block w-full rounded-md border border-[#E5E5E5] px-3 py-2 text-sm focus:border-[#14213D] focus:ring-1 focus:ring-[#14213D]" %>
          </div>

        </div>

        <!-- ACCESSIBILITY -->
        <div class="flex items-center gap-3 text-sm">
          <%= form.check_box :accessible, class: "rounded border-[#E5E5E5] text-[#14213D] focus:ring-[#14213D]" %>
          <%= form.label :accessible, class: "font-medium text-[#14213D]" %>
        </div>

      </div>

      <!-- ACTIONS -->
      <div class="mt-10 flex items-center justify-end gap-4">
        <%= link_to "Cancel", events_path,
      class: "text-sm font-medium text-gray-500 hover:text-black" %>
        <button type="submit"
          class="rounded-md bg-[#14213D] px-5 py-2 text-sm font-semibold text-white hover:opacity-90">
          Save Event
        </button>
      </div>

    <% end %>
  </div>
</div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-x-6">
      <%= link_to "Cancel", dashboard_path, class: "text-sm/6 font-semibold text-gray-900" %>
      <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Save</button>
    </div>
  <% end %>
</div>
