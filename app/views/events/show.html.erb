<div class="max-w-5xl mx-auto px-4 py-6 space-y-10">

  <!-- HERO IMAGE SECTION -->
  <div class="relative w-full h-[420px] rounded-xl overflow-hidden shadow-xl" data-controller="carousel">
    <% if @event.media_files.attached? && @event.media_files.any? %>
      <!-- Image Carousel -->
      <div class="flex overflow-x-auto snap-x snap-mandatory h-full [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] scroll-smooth" data-carousel-target="container">
        <% @event.media_files.each do |file| %>
          <div class="flex-none w-full h-full snap-start">
            <%= image_tag file, class: "w-full h-full object-cover", alt: @event.title %>
          </div>
        <% end %>
      </div>

      <!-- Navigation Arrows -->
      <% if @event.media_files.count > 1 %>
        <!-- Left Arrow -->
        <button data-action="click->carousel#prev"
                class="absolute left-4 top-1/2 -translate-y-1/2 z-20 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full transition-all duration-200 backdrop-blur-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <!-- Right Arrow -->
        <button data-action="click->carousel#next"
                class="absolute right-4 top-1/2 -translate-y-1/2 z-20 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full transition-all duration-200 backdrop-blur-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      <% end %>

      <!-- Dots Indicator -->
      <% if @event.media_files.count > 1 %>
        <div class="absolute bottom-6 left-0 right-0 flex justify-center gap-2 z-10 pointer-events-none">
          <% @event.media_files.count.times do |i| %>
            <div data-carousel-target="dot"
                 class="w-2 h-2 rounded-full bg-white/60 shadow-lg transition-all duration-300"></div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <% if Rails.root.join("app/assets/images/soccer_event.jpeg").exist? %>
        <%= image_tag "soccer_event.jpeg", class: "w-full h-full object-cover", alt: @event.title %>
      <% else %>
        <div class="w-full h-full bg-linear-to-br from-[#14213D] to-[#FCA311] flex items-center justify-center">
          <span class="text-white text-xl font-semibold">No image available</span>
        </div>
      <% end %>
    <% end %>

    <!-- Overlay -->
    <div class="absolute inset-0 bg-linear-to-br from-black/70 via-black/30 to-transparent"></div>

    <!-- Title & Actions Overlay -->
    <div class="absolute inset-x-0 bottom-0 p-6 text-white z-10">
      <h1 class="text-3xl md:text-4xl font-bold mb-4"><%= @event.title %></h1>

      <div class="flex flex-wrap gap-3">
        <!-- Back button - Always visible -->
        <%= link_to "Back to Events", events_path, class: "px-4 py-2 rounded-md bg-white/20 backdrop-blur-sm hover:bg-white/30 transition-colors text-sm font-medium" %>

        <% if user_signed_in? %>
          <% is_owner = current_user.id == @event.user_id %>
          <% is_admin = current_user.admin? %>

          <% if is_owner || is_admin %>
            <!-- Edit & Delete - Only for event owner or admin -->
            <%= link_to "Edit",
                  edit_event_path(@event),
                  class: "px-4 py-2 rounded-md bg-[#FCA311] hover:bg-[#FCA311]/90 transition-colors text-black text-sm font-semibold" %>

            <%= button_to "Delete",
                  event_path(@event),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure you want to delete this event?" },
                  class: "px-4 py-2 rounded-md bg-red-600 hover:bg-red-700 transition-colors text-white text-sm font-semibold" %>
          <% else %>
            <!-- Join/Status buttons - Only for non-owners -->
            <% if @already_enrolled %>
              <span class="px-4 py-2 rounded-md bg-green-600 text-white text-sm font-semibold flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Registered
              </span>
            <% elsif @event_full %>
              <span class="px-4 py-2 rounded-md bg-gray-600 text-white text-sm font-semibold flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                Event Full
              </span>
            <% else %>
              <%= button_to event_enrollments_path(@event),
                    method: :post,
                    data: { turbo: false },
                    class: "px-4 py-2 rounded-md bg-[#14213D] hover:bg-[#14213D]/90 transition-colors text-white text-sm font-semibold flex items-center gap-2" do %>
                Join Event
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <!-- Not signed in - Show login prompt -->
          <%= link_to new_user_session_path, class: "px-4 py-2 rounded-md bg-[#14213D] hover:bg-[#14213D]/90 transition-colors text-white text-sm font-semibold flex items-center gap-2" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
            Log in to join
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- DESCRIPTION -->
  <% if @event.description.present? %>
    <section class="bg-white rounded-xl border border-[#E5E5E5] p-6">
      <h2 class="text-lg font-semibold text-[#14213D] mb-3">
        About this event
      </h2>
      <div class="text-gray-700 leading-relaxed">
        <%= simple_format(@event.description) %>
      </div>
    </section>
  <% end %>

  <!-- EVENT DETAILS -->
  <section class="bg-white rounded-xl border border-[#E5E5E5] p-6">
    <h2 class="text-lg font-semibold text-[#14213D] mb-4">
      Event Details
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">

      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-[#FCA311] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <div>
          <div class="font-medium text-gray-900">Date & Time</div>
          <div class="text-gray-600">
            <%= @event.starts_at.present? ? @event.starts_at.strftime("%B %-d, %Y at %-I:%M %p") : "TBD" %>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-[#FCA311] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <div>
          <div class="font-medium text-gray-900">Location</div>
          <div class="text-gray-600">
            <%= [@event.location, @event.city, @event.state].compact_blank.join(", ").presence || "Online / TBA" %>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-[#FCA311] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <div>
          <div class="font-medium text-gray-900">Organizer</div>
          <div class="text-gray-600">
            <% if @event.user.present? %>
              <%= [@event.user.first_name, @event.user.last_name].compact.join(" ").presence || @event.user.email %>
            <% else %>
              N/A
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-[#FCA311] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
        </svg>
        <div>
          <div class="font-medium text-gray-900">Category</div>
          <div class="text-gray-600">
            <%= @event.category&.titleize || "N/A" %>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-[#FCA311] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <div class="font-medium text-gray-900">Price</div>
          <div class="text-gray-600">
            <% if @event.price.present? %>
              <%= @event.price.to_f == 0 ? "Free" : "$#{@event.price}" %>
            <% else %>
              Free
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-[#FCA311] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <div>
          <div class="font-medium text-gray-900">Participants</div>
          <div class="text-gray-600">
            <%= @event.participants.count %>
            <% if @event.max_capacity.present? %>
              / <%= @event.max_capacity %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-[#FCA311] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <div>
          <div class="font-medium text-gray-900">Age Range</div>
          <div class="text-gray-600">
            <% if @event.min_age.present? || @event.max_age.present? %>
              <%= @event.min_age || "Any" %> – <%= @event.max_age || "Any" %>
            <% else %>
              Any age
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-[#FCA311] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <div class="font-medium text-gray-900">RSVP Type</div>
          <div class="text-gray-600">
            <%= @event.rsvp&.humanize || "N/A" %>
          </div>
        </div>
      </div>

      <% if @event.registration_deadline.present? %>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[#FCA311] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <div class="font-medium text-gray-900">Registration Deadline</div>
            <div class="text-gray-600">
              <%= @event.registration_deadline.strftime("%B %-d, %Y at %-I:%M %p") %>
              <% if @event.registration_closed? %>
                <span class="ml-2 px-2 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded">Closed</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </section>

  <!-- PARTICIPANTS LIST -->
  <% can_view_participants = user_signed_in? && (current_user.id == @event.user_id || @event.enrollments.exists?(user_id: current_user.id)) %>

  <% if can_view_participants %>
    <section class="bg-white rounded-xl border border-[#E5E5E5] p-6">
      <h2 class="text-lg font-semibold text-[#14213D] mb-4">
        Participants
      </h2>

      <% if @participants.any? %>
        <ul class="space-y-3">
          <% @participants.each do |participant| %>
            <li class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 rounded-full bg-[#14213D] text-white flex items-center justify-center font-semibold text-xs">
                <%= [participant.first_name&.first, participant.last_name&.first].compact.join.upcase %>
              </div>
              <span class="text-gray-700">
                <%= [participant.first_name, participant.last_name].compact.join(" ").presence || participant.email %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500 text-sm">No participants yet</p>
      <% end %>
    </section>
  <% end %>

</div>