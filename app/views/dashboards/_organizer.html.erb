<!-- Header -->
<header class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-[#E5E5E5]">
  <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
    <h1 class="text-xl font-bold text-[#14213D]">
      Welcome back, <strong class="text-[#FCA311]"><%= current_user.first_name %></strong>
    </h1>

    <%= link_to new_event_path,
      class: "px-5 py-2.5 bg-[#FCA311] hover:bg-[#FCA311]/90 text-black font-semibold rounded-lg transition-colors" do %>
      Create Event
    <% end %>
  </div>
</header>

<!-- Stats -->
<section class="max-w-7xl mx-auto px-4 mt-6">
  <div class="grid grid-cols-3 gap-4">

    <!-- Upcoming -->
    <div class="bg-white border border-[#E5E5E5] rounded-xl p-4 space-y-2">
      <!-- Icon -->
      <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>

      <p class="text-xs uppercase tracking-wide text-gray-500">Upcoming</p>
      <p class="text-2xl font-bold text-[#14213D]">
        <%= @organized_events.reject(&:past?).count %>
      </p>
    </div>

    <!-- Past -->
    <div class="bg-white border border-[#E5E5E5] rounded-xl p-4 space-y-2">
      <!-- Icon -->
      <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M3 12a9 9 0 1 0 9-9"></path>
        <polyline points="3 4 3 12 11 12"></polyline>
      </svg>

      <p class="text-xs uppercase tracking-wide text-gray-500">Past</p>
      <p class="text-2xl font-bold text-[#14213D]">
        <%= @organized_events.select(&:past?).count %>
      </p>
    </div>

    <!-- Saved -->
    <div class="bg-white border border-[#E5E5E5] rounded-xl p-4 space-y-2">
      <!-- Icon -->
      <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>

      <p class="text-xs uppercase tracking-wide text-gray-500">Saved</p>
      <p class="text-2xl font-bold text-[#14213D]">
        <%= @organized_events.select(&:saved?).count %>
      </p>
    </div>

  </div>
</section>

<!-- Managed Events -->
<section class="max-w-7xl mx-auto px-4 mt-10">
  <h2 class="text-lg font-semibold text-[#14213D] mb-4">
    My Active Events
  </h2>

  <% if @organized_events.blank? %>
    <div class="bg-white border border-[#E5E5E5] rounded-xl p-6 text-center">
    <p class="text-sm text-gray-500">
      No events yet.
    </p>
  </div>
  <% else %>
    <div class="space-y-4">
      <% @events.each do |event| %>
        <div class="bg-white border border-[#E5E5E5] rounded-xl p-5 hover:shadow-md transition-shadow">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="text-sm font-semibold text-[#14213D]">
                <%= event.title %>
              </h3>
              <p class="mt-1 text-xs text-gray-500">
                <%= event.starts_at.strftime("%b %d, %Y • %-I:%M %p") %>
              </p>
            </div>

            <span class="text-xs font-semibold px-2.5 py-1 rounded-md
              <%= event.past? ? "bg-gray-100 text-gray-500" : "bg-[#14213D] text-white" %>">
              <%= event.past? ? "Past" : "Upcoming" %>
            </span>
          </div>

          <div class="mt-4 flex justify-between items-center">
            <p class="text-xs text-gray-500">
              <%= event.participants.count %> registered
            </p>

            <div class="flex gap-2">
              <%= link_to edit_event_path(event),
                class: "px-3 py-1.5 text-xs font-medium border border-[#E5E5E5] rounded-md hover:bg-gray-50" do %>
                Edit
              <% end %>

              <%= link_to event_path(event),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "px-3 py-1.5 text-xs font-medium bg-red-600 text-white rounded-md" do %>
                Delete
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<!-- Enrolled Events -->
<section class="max-w-7xl mx-auto px-4 mt-12">
  <h2 class="text-lg font-semibold text-[#14213D] mb-4">
    My Enrolled Events
  </h2>

  <div class="bg-white border border-[#E5E5E5] rounded-xl p-6 text-center">
    <p class="text-sm text-gray-500">
      You are not enrolled in any events.
    </p>
  </div>
</section>
