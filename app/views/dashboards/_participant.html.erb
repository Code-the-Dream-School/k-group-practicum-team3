<!-- Header -->
<header class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-[#E5E5E5]">
  <div class="max-w-7xl mx-auto px-4 py-4">
    <h1 class="text-xl font-bold text-[#14213D]">
      Welcome back, <strong class="text-[#FCA311]"><%= current_user.first_name %></strong>
    </h1>
  </div>
</header>

<!-- Stats -->
<section class="max-w-7xl mx-auto px-4 mt-6">
  <div class="grid grid-cols-3 gap-4">

    <!-- Upcoming -->
    <div class="bg-white border border-[#E5E5E5] rounded-xl p-4 space-y-2">
      <!-- Icon -->
      <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>

      <p class="text-xs uppercase tracking-wide text-gray-500">Upcoming</p>
      <p class="text-2xl font-bold text-[#14213D]">
        <%= enrolled_events.reject(&:past?).count %>
      </p>
    </div>

    <!-- Past -->
    <div class="bg-white border border-[#E5E5E5] rounded-xl p-4 space-y-2">
      <!-- Icon -->
      <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M3 12a9 9 0 1 0 9-9"></path>
        <polyline points="3 4 3 12 11 12"></polyline>
      </svg>

      <p class="text-xs uppercase tracking-wide text-gray-500">Past</p>
      <p class="text-2xl font-bold text-[#14213D]">
        <%= enrolled_events.select(&:past?).count %>
      </p>
    </div>

    <!-- Saved -->
    <div class="bg-white border border-[#E5E5E5] rounded-xl p-4 space-y-2">
      <!-- Icon -->
      <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>

      <p class="text-xs uppercase tracking-wide text-gray-500">Saved</p>
      <p class="text-2xl font-bold text-[#14213D]">
        <%= current_user.favorites.count %>
      </p>
    </div>

  </div>
</section>


<!-- Active Events -->
<section class="max-w-7xl mx-auto px-4 mt-10">
  <h2 class="text-lg font-semibold text-[#14213D] mb-4">
    My Events
  </h2>

  <% if enrolled_events.empty? %>
      <div class="bg-white border border-[#E5E5E5] rounded-xl p-6 text-center">
        <p class="text-sm text-gray-500">
          You are not enrolled in any events.
        </p>
      </div>
  <% else %>
    <div class="space-y-4">
      <% enrolled_events.each do |event| %>
        <div class="bg-white border border-[#E5E5E5] rounded-xl p-5 hover:shadow-md transition-shadow">
          <h3 class="text-base font-semibold text-[#14213D]">
            <%= event.title %>
          </h3>

          <p class="mt-1 text-sm text-gray-500">
            <%= event.starts_at.strftime("%b %d • %-I:%M %p") %>
          </p>

          <%= link_to event_path(event),
            class: "inline-block mt-4 px-4 py-2 text-sm font-semibold bg-[#FCA311] text-black rounded-lg hover:bg-[#FCA311]/90 transition-colors" do %>
            View Event
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<!-- Recommended Events -->
<section class="max-w-7xl mx-auto px-4 mt-12">
  <h2 class="text-lg font-semibold text-[#14213D] mb-4">
    Recommended for You
  </h2>

  <% if @recommended_events.empty? %>
      <div class="bg-white border border-[#E5E5E5] rounded-xl p-6 text-center">
        <p class="text-sm text-gray-500">
          No recommended events available.
        </p>
      </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @recommended_events.first(3).each do |event| %>
        <article class="group bg-white border border-[#E5E5E5] rounded-xl overflow-hidden hover:shadow-lg transition-shadow">
          <%= link_to event_path(event), class: "block" do %>

            <!-- Image Carousel -->
            <div class="relative h-48 overflow-hidden bg-gray-100">
              <div class="flex items-center justify-center h-full text-sm text-gray-400">
                No image available
              </div>
            </div>

            <!-- Content -->
            <div class="p-4 space-y-2">
              <h3 class="text-base font-semibold text-[#14213D] leading-tight line-clamp-2 group-hover:text-[#FCA311] transition-colors">
                <%= event.title %>
              </h3>

              <div class="flex items-center gap-2 text-xs text-gray-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>
                  <% if event.starts_at.present? %>
                    <%= event.starts_at.strftime("%b %-d, %Y") %>
                  <% else %>
                    Date TBD
                  <% end %>
                </span>
              </div>

              <% if event.user.present? %>
                <div class="flex items-center gap-2 text-xs text-gray-400 pt-1 border-t border-gray-100">
                  <span>by <%= [event.user.first_name, event.user.last_name].compact.join(" ").presence || event.user.email %></span>
                </div>
              <% end %>
            </div>

          <% end %>
        </article>
      <% end %>
    </div>
  <% end %>
</section>
